# Copie ce fichier en ".env" puis remplis les valeurs. Ne partage JAMAIS le fichier .env.

# Discord Developer Portal → ton application → Bot → Reset Token
DISCORD_TOKEN=

# Adresse de ta base Firebase (Realtime Database → en haut de l'onglet Données)
FIREBASE_DATABASE_URL=https://linkgeek-edff5-default-rtdb.europe-west1.firebasedatabase.app

# Dépôt GitHub dont le bot annonce les nouvelles versions
GITHUB_REPO=unknownxsr/linkgeek
