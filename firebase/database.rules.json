    },
    "lfg": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'level', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 500"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
        },
        "game": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      ".read": "auth != null && auth.token.email === '__ADMIN_EMAIL__' && auth.token.email_verified === true",
      "$id": {
        ".write": "auth != null && ((auth.token.email === '__ADMIN_EMAIL__' && auth.token.email_verified === true && !newData.exists()) || (!data.exists() && newData.child('uid').val() === auth.uid))",
        ".validate": "$id.matches(/^[A-Za-z0-9]{20}$/) && newData.hasChildren(['uid', 'name', 'msg', 'at'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "referrals": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() !== $uid && root.child('users').child(newData.child('by').val()).exists() && root.child('users').child($uid).child('joinedAt').val() > now - 1209600000",
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "refBy": {
      "$by": {
        ".read": "auth != null && auth.uid === $by",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $uid !== $by && !data.exists() && newData.parent().parent().parent().child('referrals').child($uid).child('by').val() === $by",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
